# ---- Banco ----
# Postgres com a extensão pgvector. O host é o nome (ou alias) do container na rede Docker abaixo.
# O scripts/setup_db.sh cria o banco e troca TROQUE_AQUI pela senha do container.
DATABASE_URL=postgresql://postgres:TROQUE_AQUI@postgres:5432/facecheck

# ---- Docker (usadas pelo docker-compose.yml) ----
# Rede Docker externa onde o Postgres está acessível (crie com: docker network create facecheck_net)
DOCKER_NETWORK=facecheck_net
# Porta local da aplicação (http://localhost:8090) e porta extra opcional (túnel/proxy reverso)
APP_PORT=8090
PUBLIC_PORT=8000

# ---- Reconhecimento ----
# Similaridade cosseno mínima para aceitar um match (ArcFace buffalo_l: 0.40–0.50)
MATCH_THRESHOLD=0.45
# Menor lado do rosto (px, no frame enviado) para ser considerado
MIN_FACE_PX=60
# Fuso para "hoje", filtros de data e horários do CSV
APP_TZ=America/Sao_Paulo

# ---- Prova de vida ----
# passive (anti-spoofing em todo quadro, desafio só na dúvida) | active (sempre desafio) | off
LIVENESS=passive
# Camada passiva: média da probabilidade "real" (0..1) nos últimos quadros
SPOOF_REAL_MIN=0.80
SPOOF_FAKE_MAX=0.40
SPOOF_FRAMES=2
# Desafio de virar a cabeça (na dúvida em passive; sempre em active)
LIVENESS_SIDES=1
LIVENESS_YAW_TURN=0.25
LIVENESS_TIMEOUT=8
